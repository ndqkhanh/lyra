# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-opus-20240229

# Agent0 Configuration
AGENT0_MAX_ITERATIONS=10
AGENT0_SYNTHETIC_TASK_COUNT=100

# SkillRL Configuration
SKILLRL_EVOLUTION_INTERVAL=3600000
SKILLRL_TOP_K=10
SKILLRL_ERROR_THRESHOLD=0.3
SKILLRL_CONFIDENCE_THRESHOLD=0.7

# Meta-Harness Configuration
META_HARNESS_MAX_ITERATIONS=5
META_HARNESS_SEARCH_DIR=./benchmarks

# AlphaEvolve Configuration
ALPHA_EVOLVE_MAX_GENERATIONS=10
ALPHA_EVOLVE_POPULATION_SIZE=20
ALPHA_EVOLVE_MUTATION_RATE=0.1

# Post-Training Configuration
POST_TRAINING_COMPUTE_BUDGET=10000

# HyperAgent Configuration
HYPER_AGENT_SANDBOX_ENABLED=true

# Safety Configuration
SAFETY_MAX_DEGRADATION=0.1
SAFETY_EXPLOSION_THRESHOLD=2.0
SAFETY_GENERATION_INTERVAL=5

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/lyra-rsi.log
